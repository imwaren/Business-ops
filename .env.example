# Copy to .env and fill in real values. Never commit .env.
# Rotate every credential that was previously hardcoded in source.

CI_ENVIRONMENT = production

# Detailed, redacted HTTP 500 responses are opt-in. Current UAT/production enable
# this in their private .env; the default for new installations remains false.
ERROR_RESPONSE_DETAILS = false

app.baseURL = 'https://accounting-back.myt-emr.com/'
app.forceGlobalSecureRequests = true
cookie.secure = true

# Admin role.id (privileged user/role/permission mutations and full-module bypass)
ROLE_ADMIN = 4
# IT role.id — endorsement / email notification recipients only (not privileged API gate)
ROLE_IT = 17

# Comma-separated allowed API keys (hash compared). API_KEY is also accepted.
API_KEY =
API_KEYS =

# Required for /cron/* when not invoked via CLI
CRON_SECRET =

# Comma-separated allowed API keys (hash compared). API_KEY is also accepted.
CSR_API_KEY =
CSR_API_KEYS =

ENCRYPTION_KEY =
encryption.key =

database.default.hostname = 127.0.0.1
database.default.port = 3306
database.default.username =
database.default.password =
# Each connection can override database.<group>.hostname/port/username/password/database.
# Per-group database values take precedence over the corresponding *_DB schema setting.
DB_MOBILE_USERNAME =
DB_MOBILE_PASSWORD =

MASTER_DB = mytemr_master
MOBILE_DB = mytemr_diagnostic_mobile
OAKRIDGE_DB = mytemr_diagnostic
MAC_DB = mytemr_diagnostic_mactan
CONSO_DB = mytemr_diagnostic_conso
MANTLEWOOD_DB = mytemr_diagnostic_mantlewood
WAREHOUSE_DB = mytemr_oakridge_warehouse
PHARMACY_DB = mytemr_oakridge_pharmacy
REPORT_DB = mytemr_reports
OAKRIDGE_EMR_DB = mytemr_emr
MAC_EMR_DB = mytemr_emr_mactan
CONSO_EMR_DB = mytemr_emr_conso
MANTLEWOOD_EMR_DB = mytemr_emr_mantlewood
MOBILE_EMR_DB = mytemr_mobile

MYT_EMAIL =
MYT_NAME = 'CLINICA PRIME'
MYT_PASSWORD =
OUTLOOK_EMAIL =
OUTLOOK_EMAIL_PASSWORD =

VM4_ENDPOINT = 'https://file.myt-emr.com/'
VM4_SECRET_TOKEN =

FRONT_END_URL = 'https://business-ops.myt-emr.com,https://accounting-front.myt-emr.com'
CORS_ALLOWED_ORIGINS = 'https://business-ops.myt-emr.com,https://accounting-front.myt-emr.com,https://corporate-portal.myt-emr.com'

# UAT (zuat-accounting-back.myt-emr.com) — use these instead of the production pair:
# app.baseURL = 'https://zuat-accounting-back.myt-emr.com/'
# FRONT_END_URL = 'https://zuat-accounting-front.myt-emr.com'
# CORS_ALLOWED_ORIGINS = 'https://zuat-accounting-front.myt-emr.com,https://corporate-portal.myt-emr.com'

DICOM_UPLOAD_WORKLIST_URL = 'https://diagnostic-mobile-api.myt-emr.com/dicom/upload_worklist'
DICOM_API_KEY =
DICOM_STATION_AET = '1,2,3,4_AET'

# Optional shared Excel worker settings; web and CLI must use the same private directory.
# EXCEL_EXPORT_DIR = /private/application/exports
# EXCEL_EXPORT_PHP_CLI = /usr/bin/php8.3
