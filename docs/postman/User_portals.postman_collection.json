            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{token}}\",\n  \"requester\": {{requester}},\n  \"company_id\": 10,\n  \"user_portals\": [\n    {\n      \"username\": \"portal_user_a\",\n      \"password\": \"Secret123\"\n    },\n    {\n      \"company_id\": 10,\n      \"username\": \"portal_user_b\",\n      \"password\": \"Secret456\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/user_portals/create_multiple",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user_portals",
            "create_multiple"
          ]
        },
        "description": "## POST `/user_portals/create_multiple`\n\nInsert-only bulk create.\n\n### Required\n- `token`, `requester`\n- Header `API-KEY`\n- `user_portals` — non-empty array\n\n### `user_portals[]`\n| Field | Type | Notes |\n|-------|------|-------|\n| `company_id` | number | Optional per item if top-level `company_id` is set |\n| `username` | string | Required |\n| `password` | string | bcrypt-hashed server-side |\n\nTop-level `company_id` is used as fallback when an item omits `company_id`.\n\n### Success\n```json\n{\n  \"user_portal_ids\": [5, 6],\n  \"message\": \"user_portals added successfully.\"\n}\n```"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"user_portal_ids\": [5, 6],\n  \"message\": \"user_portals added successfully.\"\n}"
        }
      ]
    },
