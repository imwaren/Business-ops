          "raw": "{\n  \"token\": \"{{token}}\",\n  \"requester\": {{requester}},\n  \"user_portal_id\": 5,\n  \"password\": \"NewSecret123\",\n  \"is_changed\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/user_portals/change_password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user_portals",
            "change_password"
          ]
        },
        "description": "## POST `/user_portals/change_password`\n\nChanges portal password and marks `is_changed = 1`.\n\n### Required\n- `token`, `requester`\n- Header `API-KEY`\n- `user_portal_id`\n- `password`\n\n### Optional\n- `is_changed` — if `1` and portal already has `is_changed = 1`, request fails with \"Password is already changed.\"\n\n### Success\n```json\n{\n  \"user_portal_id\": 5,\n  \"message\": \"Password changed successfully.\"\n}\n```"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"user_portal_id\": 5,\n  \"message\": \"Password changed successfully.\"\n}"
        }
      ]
    }
  ]
