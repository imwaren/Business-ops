            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"portal_user\",\n  \"password\": \"Secret123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/user_portals/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user_portals",
            "login"
          ]
        },
        "description": "## POST `/user_portals/login`\n\nPatient portal login. No admin `token`/`requester`/`API-KEY` required.\n\n### Required\n- `username`\n- `password`\n\n### Success\nReturns user_portal row (password unset) with `token`, `token_expiry`, and `message`.\n\n### Failures\n- Unregistered user\n- Incorrect password"
      },
      "response": [
        {
          "name": "Success",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"portal_user\",\n  \"password\": \"Secret123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user_portals/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user_portals",
                "login"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"id\": 5,\n  \"company_id\": 10,\n  \"username\": \"portal_user\",\n  \"token\": \"generated-token\",\n  \"token_expiry\": \"2026-08-04 23:00:00\",\n  \"message\": \"Login successful\"\n}"
        }
      ]
    },
