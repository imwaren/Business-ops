          "raw": "{\n  \"token\": \"{{token}}\",\n  \"requester\": {{requester}},\n  \"user_portal_id\": 5,\n  \"username\": \"portal_user_updated\",\n  \"password\": \"OptionalNewSecret\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/user_portals/update",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user_portals",
            "update"
          ]
        },
        "description": "## POST `/user_portals/update`\n\nUpdates a single user_portal by `user_portal_id`.\n\n### Required\n- `token`, `requester`\n- Header `API-KEY`\n- `user_portal_id`\n\n### Optional\n- `company_id`, `username`, `password` (password hashed only when present)\n\n### Success\n```json\n{\n  \"user_portal_id\": 5,\n  \"message\": \"user_portal updated successfully.\"\n}\n```"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"user_portal_id\": 5,\n  \"message\": \"user_portal updated successfully.\"\n}"
        }
      ]
    },
    {
      "name": "Update multiple",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "API-KEY",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{token}}\",\n  \"requester\": {{requester}},\n  \"company_id\": 10,\n  \"user_portals\": [\n    {\n      \"id\": 5,\n      \"username\": \"existing_user\",\n      \"password\": \"OptionalNewSecret\"\n    },\n    {\n      \"username\": \"new_user\",\n      \"password\": \"Secret123\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/user_portals/update_multiple",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user_portals",
            "update_multiple"
          ]
        },
        "description": "## POST `/user_portals/update_multiple`\n\nCompany-scoped details sync for user_portals.\n\n### Required\n- `token`, `requester`\n- Header `API-KEY`\n- `company_id`\n- `user_portals` — array (may be empty to soft-delete all active portals for the company)\n\n### Sync rules\n- Item with `id` → update existing row; sets `is_deleted = 0`\n- Item without `id` → insert new row with `is_deleted = 0`\n- Existing active portals for `company_id` whose `id` is omitted → soft-deleted (`is_deleted = 1`)\n- `password` on update is hashed only when non-empty; omit to leave password unchanged\n\n### Success\n```json\n{\n  \"company_id\": 10,\n  \"message\": \"user_portals updated successfully.\"\n}\n```"
      },
      "response": [
        {
          "name": "Success",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "API-KEY",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"requester\": {{requester}},\n  \"company_id\": 10,\n  \"user_portals\": [\n    {\n      \"id\": 5,\n      \"username\": \"existing_user\",\n      \"password\": \"OptionalNewSecret\"\n    },\n    {\n      \"username\": \"new_user\",\n      \"password\": \"Secret123\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/user_portals/update_multiple",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user_portals",
                "update_multiple"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"company_id\": 10,\n  \"message\": \"user_portals updated successfully.\"\n}"
        }
      ]
    },
