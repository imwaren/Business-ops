        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{token}}\",\n  \"requester\": {{requester}},\n  \"company_id\": 10,\n  \"username\": \"portal_user\",\n  \"password\": \"Secret123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/user_portals/create",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user_portals",
            "create"
          ]
        },
        "description": "## POST `/user_portals/create`\n\nCreates a single user_portal. Password is bcrypt-hashed server-side.\n\n### Required\n- `token`, `requester`\n- Header `API-KEY`\n- `company_id`, `username`, `password`\n\n### Success\n```json\n{\n  \"user_portal_id\": 5,\n  \"message\": \"user_portal added successfully.\"\n}\n```"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"user_portal_id\": 5,\n  \"message\": \"user_portal added successfully.\"\n}"
        }
      ]
    },
    {
      "name": "Create multiple",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "API-KEY",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
