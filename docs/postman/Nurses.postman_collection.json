        ],
        "url": {
          "raw": "{{base_url}}/nurses/get?token={{token}}&requester={{requester}}",
          "host": ["{{base_url}}"],
          "path": ["nurses", "get"],
          "query": [
            { "key": "token", "value": "{{token}}" },
            { "key": "requester", "value": "{{requester}}" },
            { "key": "nurse_id", "value": "", "disabled": true },
            { "key": "status", "value": "active", "disabled": true },
            { "key": "term", "value": "", "disabled": true },
            { "key": "page", "value": "1", "disabled": true },
            { "key": "data_size", "value": "10", "disabled": true }
          ]
        },
        "description": "## GET `/nurses/get`\n\nReads from **master** only."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"size\": 1,\n  \"data\": [\n    {\n      \"id\": 1,\n      \"first_name\": \"Maria\",\n      \"last_name\": \"Santos\",\n      \"username\": \"msantos\",\n      \"branch_in\": \"1,2,4\",\n      \"status\": \"active\"\n    }\n  ]\n}"
        }
      ]
    },
