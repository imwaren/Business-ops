            },
            {
              "key": "transaction_id",
              "value": "1",
              "disabled": true
            },
            {
              "key": "invoice_status",
              "value": "unprinted",
              "disabled": true,
              "description": "printed | unprinted"
            },
            {
              "key": "mobile_van_id",
              "value": "1",
              "disabled": true,
              "description": "Filter payment.mobile_van_id"
            },
            {
              "key": "mode_of_payment",
              "value": "cash",
              "disabled": true,
              "description": "Filter payment_multiple_method.type (cash, card, gcash, others, ...)"
            },
            {
              "key": "date_from",
              "value": "2026-01-01",
              "disabled": true,
              "description": "Filter payment.payment_date from (use with date_to)"
            },
            {
              "key": "date_to",
              "value": "2026-01-31",
              "disabled": true,
              "description": "Filter payment.payment_date to (use with date_from)"
            },
            {
              "key": "term",
              "value": "Dela Cruz",
              "disabled": true,
              "description": "Patient name or transaction_no"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "data_size",
              "value": "10"
            }
          ]
        },
        "description": "## GET `/billings/get_mobile_payment`\n\nList mobile CSR payments. Always reads the **mobile** clinic DB.\n\nEach row includes `mobile_van_name` (from `payment.mobile_van_id` → master `mobile_van.name`), nested `transaction`, and nested `payment_multiple_method` (includes `status`, `posted_by`, `posted_on`). The `booking` array is **not** returned.\n\n### Query params\n| Param | Required | Notes |\n|-------|----------|-------|\n| `token` | yes | Auth token |\n| `requester` | yes | User id |\n| `branch_id` | no | Ignored; connection is always mobile |\n| `payment_id` | no | Filter by payment id |\n| `transaction_id` | no | Filter by transaction id |\n| `invoice_status` | no | `printed` / `unprinted` |\n| `mobile_van_id` | no | `payment.mobile_van_id` |\n| `mode_of_payment` | no | `payment_multiple_method.type` (payment included if any method matches) |\n| `date_from` / `date_to` | no | `payment.payment_date` range (both required together) |\n| `term` | no | Patient name or transaction_no |\n| `page` | no | 1-based page |\n| `data_size` | no | Page size |\n\n### Success\n`{ \"size\": n, \"data\": [ ... ] }` — `size` is the unpaginated count."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"size\": 1,\n  \"data\": [\n    {\n      \"id\": 10,\n      \"transaction_id\": 55,\n      \"mobile_van_id\": 2,\n      \"mobile_van_name\": \"Van A\",\n      \"payment_date\": \"2026-01-15\",\n      \"grand_total\": \"1500.00\",\n      \"invoice_status\": null,\n      \"transaction\": {\n        \"id\": 55,\n        \"transaction_no\": \"M-2026-00055\"\n      },\n      \"payment_multiple_method\": [\n        {\n          \"id\": 21,\n          \"payment_id\": 10,\n          \"type\": \"cash\",\n          \"amount\": \"1500.00\",\n          \"status\": \"unposted\",\n          \"posted_by\": null,\n          \"posted_on\": null\n        }\n      ]\n    }\n  ]\n}"
        },
        {
          "name": "Not Found",
          "status": "Not Found",
          "code": 404,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"error_messages\": [\n    \"No billing soa found.\"\n  ]\n}"
        }
      ]
    },
    {
      "name": "Change mobile payment method status",
      "request": {
