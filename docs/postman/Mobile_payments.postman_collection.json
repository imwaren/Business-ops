              "type": "text",
              "description": "payment_multiple_method.id"
            },
            {
              "key": "status",
              "value": "posted",
              "type": "text",
              "description": "posted | unposted"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/billings/change_status_mobile_payment_method",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billings",
            "change_status_mobile_payment_method"
          ]
        },
        "description": "## POST `/billings/change_status_mobile_payment_method`\n\nPost or unpost a `payment_multiple_method` row. Always uses the **mobile** clinic DB.\n\n### Form fields\n| Field | Required | Notes |\n|-------|----------|-------|\n| `token` | yes | Auth token |\n| `requester` | yes | User id + audit `posted_by` |\n| `payment_multiple_method_id` | yes | `payment_multiple_method.id` |\n| `status` | yes | `posted` or `unposted` |\n\n### Effects\n- `posted`: sets `status`, `posted_by`, `posted_on`\n- `unposted`: sets `status` to `unposted` and clears `posted_by` / `posted_on`\n\n### Errors\n- `400` — missing id, invalid status, already that status, or update failed\n- `404` — record not found\n- `401` — invalid/missing API-KEY, token, or requester"
      },
      "response": [
        {
          "name": "Posted",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"payment_multiple_method_id\": 1,\n  \"message\": \"payment_multiple_method posted successfully.\"\n}"
        },
        {
          "name": "Unposted",
