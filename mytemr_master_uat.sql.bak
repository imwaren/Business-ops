--
-- Triggers `costing_manpower`
--
DELIMITER $$
CREATE TRIGGER `costing_manpower_after_update` AFTER UPDATE ON `costing_manpower` FOR EACH ROW BEGIN
	  #for trails
    IF (NEW.costing_id <> OLD.costing_id) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'costing_id', old_value = OLD.costing_id, new_value = NEW.costing_id, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.description <> OLD.description) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'description', old_value = OLD.description, new_value = NEW.description, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.manpower_type <> OLD.manpower_type) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'manpower_type', old_value = OLD.manpower_type, new_value = NEW.manpower_type, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.qty <> OLD.qty) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'qty', old_value = OLD.qty, new_value = NEW.qty, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.daily_rate <> OLD.daily_rate) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'daily_rate', old_value = OLD.daily_rate, new_value = NEW.daily_rate, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.total_daily_rate <> OLD.total_daily_rate) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'total_daily_rate', old_value = OLD.total_daily_rate, new_value = NEW.total_daily_rate, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.meals <> OLD.meals) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'meals', old_value = OLD.meals, new_value = NEW.meals, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.ingress_count <> OLD.ingress_count) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'ingress_count', old_value = OLD.ingress_count, new_value = NEW.ingress_count, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.rate <> OLD.rate) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'rate', old_value = OLD.rate, new_value = NEW.rate, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.pax_per_hour <> OLD.pax_per_hour) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'pax_per_hour', old_value = OLD.pax_per_hour, new_value = NEW.pax_per_hour, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.minutes_per_pax <> OLD.minutes_per_pax) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'minutes_per_pax', old_value = OLD.minutes_per_pax, new_value = NEW.minutes_per_pax, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.active_hours <> OLD.active_hours) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'active_hours', old_value = OLD.active_hours, new_value = NEW.active_hours, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.suggested_qty <> OLD.suggested_qty) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'suggested_qty', old_value = OLD.suggested_qty, new_value = NEW.suggested_qty, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.patient_per_shift <> OLD.patient_per_shift) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'patient_per_shift', old_value = OLD.patient_per_shift, new_value = NEW.patient_per_shift, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

  IF (NEW.is_deleted <> OLD.is_deleted) THEN

    INSERT INTO trail set description = OLD.id, table_name = 'costing_manpower', col_name = 'is_deleted', old_value = OLD.is_deleted, new_value = NEW.is_deleted, added_by = NEW.updated_by, added_on = NEW.updated_on;

  END IF;
END
$$
DELIMITER ;

-- --------------------------------------------------------

--
-- Table structure for table `costing_manpower_cost`
--

CREATE TABLE `costing_manpower_cost` (
  `id` int(11) NOT NULL,
  `costing_id` int(11) NOT NULL,
  `description` text COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `shift_no` int(11) DEFAULT NULL,
  `basic_pay` decimal(13,2) DEFAULT 0.00,
  `premium_pay` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `premium_pay_amount` decimal(13,2) NOT NULL DEFAULT 0.00,
  `premium_hrs` decimal(13,2) DEFAULT 0.00,
  `ingress_hrs` decimal(13,2) DEFAULT 0.00,
  `total_premium_pay` decimal(13,2) DEFAULT 0.00,
  `total` decimal(13,2) DEFAULT 0.00,
  `added_by` int(11) NOT NULL,
  `added_on` datetime NOT NULL,
  `updated_by` int(11) DEFAULT NULL,
