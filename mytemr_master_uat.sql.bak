--
-- Table structure for table `request`
--

CREATE TABLE `request` (
  `id` int(11) NOT NULL,
  `version_no` int(11) NOT NULL DEFAULT 1,
  `company_id` int(11) DEFAULT NULL,
  `customer_account_id` varchar(250) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `reference_no` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `name` varchar(250) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `description` text COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `request_type` enum('new','repeat','custom') COLLATE utf8mb4_unicode_ci DEFAULT 'new',
  `priority` enum('low','medium','high','urgent') COLLATE utf8mb4_unicode_ci DEFAULT 'medium',
  `due_date` date DEFAULT NULL,
  `contact_person` varchar(150) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `contact_number` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `email` varchar(150) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `delivery_address` text COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `payment_terms` text COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `grand_total` decimal(13,2) NOT NULL DEFAULT 0.00,
  `date` date DEFAULT NULL,
  `sae_in_charge_id` int(11) DEFAULT NULL,
  `rdt_requester` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'branch',
  `mode_of_payment` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `preferred_branch_id` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `hmo_account_name` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `estimated_headcount` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `number_of_days` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `shift` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
