--
-- Table structure for table `quotation_detail`
--

CREATE TABLE `quotation_detail` (
  `id` int(11) NOT NULL,
  `quotation_id` int(11) NOT NULL,
  `lab_test_id` int(11) NOT NULL,
  `branch_id` varchar(11) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `quantity` decimal(13,2) DEFAULT 0.00,
  `unit_price` decimal(13,2) DEFAULT 0.00,
  `total_amount` decimal(13,2) NOT NULL DEFAULT 0.00,
  `discount` decimal(13,2) NOT NULL DEFAULT 0.00,
  `pro_rate_price` decimal(13,2) NOT NULL DEFAULT 0.00,
  `margin` decimal(13,2) NOT NULL DEFAULT 0.00,
  `cost` decimal(13,2) NOT NULL DEFAULT 0.00,
  `added_by` int(11) NOT NULL,
  `added_on` datetime NOT NULL,
  `updated_by` int(11) DEFAULT NULL,
  `updated_on` datetime DEFAULT NULL,
  `is_deleted` tinyint(4) NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------

--
-- Table structure for table `quotation_history`
--

CREATE TABLE `quotation_history` (
  `id` bigint(20) NOT NULL,
  `version_no` bigint(20) NOT NULL,
  `source_id` bigint(20) NOT NULL,
  `col_name` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `old_value` mediumtext COLLATE utf8mb4_unicode_ci NOT NULL,
  `new_value` mediumtext COLLATE utf8mb4_unicode_ci NOT NULL,
  `added_by` bigint(20) DEFAULT NULL,
  `added_on` datetime DEFAULT NULL,
  `is_deleted` int(1) NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

