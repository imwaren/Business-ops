--
-- Table structure for table `endorsement`
--

CREATE TABLE `endorsement` (
  `id` int(11) NOT NULL,
  `version_no` int(11) NOT NULL DEFAULT 1,
  `request_id` int(11) NOT NULL,
  `costing_id` int(11) NOT NULL,
  `quotation_id` int(11) NOT NULL,
  `branch_id` varchar(11) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `type` enum('open','closed') COLLATE utf8mb4_unicode_ci NOT NULL,
  `status` enum('pending','approved','disapproved','archived','returned') COLLATE utf8mb4_unicode_ci DEFAULT 'pending',
  `endorsement_date` datetime DEFAULT NULL,
  `transaction_type` varchar(250) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `company_id` int(11) DEFAULT NULL,
  `address` varchar(250) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `preferred_branch_id` varchar(11) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `mobile_branch_id` int(11) DEFAULT NULL,
  `mode_of_releasing` varchar(250) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
