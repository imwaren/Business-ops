--
-- Triggers `costing_mobilization`
--
DELIMITER $$
CREATE TRIGGER `costing_mobilization_after_update` AFTER UPDATE ON `costing_mobilization` FOR EACH ROW BEGIN
	  #for trails
    IF (NEW.costing_id <> OLD.costing_id) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_mobilization', col_name = 'costing_id', old_value = OLD.costing_id, new_value = NEW.costing_id, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.description <> OLD.description) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_mobilization', col_name = 'description', old_value = OLD.description, new_value = NEW.description, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.unit <> OLD.unit) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_mobilization', col_name = 'unit', old_value = OLD.unit, new_value = NEW.unit, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.amount <> OLD.amount) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_mobilization', col_name = 'amount', old_value = OLD.amount, new_value = NEW.amount, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

    IF (NEW.total <> OLD.total) THEN

      INSERT INTO trail set description = OLD.id, table_name = 'costing_mobilization', col_name = 'total', old_value = OLD.total, new_value = NEW.total, added_by = NEW.updated_by, added_on = NEW.updated_on;

    END IF;

  IF (NEW.is_deleted <> OLD.is_deleted) THEN

    INSERT INTO trail set description = OLD.id, table_name = 'costing_mobilization', col_name = 'is_deleted', old_value = OLD.is_deleted, new_value = NEW.is_deleted, added_by = NEW.updated_by, added_on = NEW.updated_on;

  END IF;
END
$$
DELIMITER ;

