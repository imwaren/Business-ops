--
-- Table structure for table `request_consultation`
--

CREATE TABLE `request_consultation` (
  `id` int(11) NOT NULL,
  `request_id` int(11) NOT NULL,
  `company_id` int(11) NOT NULL,
  `specialization_id` int(11) NOT NULL,
  `fee_amount` decimal(13,2) NOT NULL,
  `added_by` int(11) NOT NULL,
  `added_on` datetime NOT NULL,
  `updated_by` int(11) DEFAULT NULL,
  `updated_on` datetime DEFAULT NULL,
  `is_deleted` tinyint(4) NOT NULL DEFAULT 0,
  `doctor_share` decimal(13,2) NOT NULL DEFAULT 0.00 COMMENT 'percentage',
  `ahmopi_fee` decimal(13,2) NOT NULL DEFAULT 0.00,
  `pahmoc_fee` decimal(13,2) NOT NULL DEFAULT 0.00,
  `charge_to` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT 'company',
  `charge_to_ids` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

