--
-- Table structure for table `endorsement`
--

CREATE TABLE `endorsement` (
  `id` int(11) NOT NULL,
  `version_no` int(11) NOT NULL DEFAULT 1,
  `request_id` int(11) NOT NULL,
  `costing_id` int(11) NOT NULL,
  `quotation_id` int(11) NOT NULL,
  `branch_id` varchar(11) DEFAULT NULL,
  `type` enum('open','closed') NOT NULL,
  `status` enum('pending','approved','disapproved','archived','returned') DEFAULT 'pending',
  `endorsement_date` datetime DEFAULT NULL,
  `transaction_type` varchar(250) DEFAULT NULL,
  `company_id` int(11) DEFAULT NULL,
  `address` varchar(250) DEFAULT NULL,
  `preferred_branch_id` varchar(11) DEFAULT NULL,
  `mobile_branch_id` int(11) DEFAULT NULL,
  `mode_of_releasing` varchar(250) DEFAULT NULL,
  `results_tat` varchar(250) DEFAULT NULL,
  `significant_findings` varchar(250) DEFAULT NULL,
  `email` varchar(250) DEFAULT NULL,
  `time` time DEFAULT NULL,
  `head_count` varchar(250) DEFAULT NULL,
  `compliance_report` varchar(250) DEFAULT NULL,
  `completion_period` date DEFAULT NULL,
  `no_show_valid_until` date DEFAULT NULL,
  `payment_terms` varchar(250) DEFAULT NULL,
  `date_from` date DEFAULT NULL,
  `date_to` date DEFAULT NULL,
  `contract_date_from` date DEFAULT NULL,
  `contract_date_to` date DEFAULT NULL,
  `ape_results_tat` varchar(250) DEFAULT NULL,
  `requirement` varchar(250) DEFAULT NULL,
  `note` varchar(250) DEFAULT NULL,
  `effectivity_date_from` date DEFAULT NULL,
  `effectivity_date_to` date DEFAULT NULL,
  `service_duration_date_from` date DEFAULT NULL,
  `service_duration_date_to` date DEFAULT NULL,
  `remarks` text DEFAULT NULL,
  `mobile_site` varchar(255) DEFAULT NULL,
  `email_result` varchar(250) DEFAULT NULL,
  `evaluation_data_source` varchar(255) DEFAULT NULL,
  `evaluation` varchar(255) DEFAULT NULL,
  `mandatory_tests` varchar(255) DEFAULT NULL,
  `optional_tests` varchar(255) DEFAULT NULL,
  `registration_cut_off` time DEFAULT NULL,
  `submission_cut_off` time DEFAULT NULL,
  `kind_of_break` varchar(250) DEFAULT NULL,
  `mobile_activity_date_from` date DEFAULT NULL,
  `mobile_activity_date_to` date DEFAULT NULL,
  `clinic_activity_date_from` date DEFAULT NULL,
  `clinic_activity_date_to` date DEFAULT NULL,
  `completion_date` date DEFAULT NULL,
  `completion_date_from` datetime DEFAULT NULL,
  `completion_date_to` datetime DEFAULT NULL,
  `demographics_report_date` date DEFAULT NULL,
  `package_name` varchar(255) DEFAULT NULL,
  `guaranteed_headcount` varchar(250) DEFAULT NULL,
  `cost_total` decimal(13,2) NOT NULL DEFAULT 0.00,
  `estimated_margin_total` decimal(13,2) NOT NULL DEFAULT 0.00,
  `estimated_margin_amount_total` decimal(13,2) NOT NULL DEFAULT 0.00,
  `age_for_ecg` varchar(250) DEFAULT NULL,
  `age_for_papsmear` varchar(250) DEFAULT NULL,
  `estimated_patient_per_shift` varchar(250) DEFAULT NULL,
  `with_masterlist` int(1) NOT NULL DEFAULT 0,
  `with_walk_in` int(1) NOT NULL DEFAULT 0,
  `is_pending_revision` int(11) NOT NULL DEFAULT 0,
  `is_force_evaluate` int(11) NOT NULL DEFAULT 0,
  `force_evaluate_reason` varchar(255) DEFAULT NULL,
  `force_evaluate_by` int(11) DEFAULT NULL,
  `force_evaluate_on` datetime DEFAULT NULL,
  `approved_by` int(11) DEFAULT NULL,
  `approved_on` datetime DEFAULT NULL,
  `disapproved_by` int(11) DEFAULT NULL,
  `disapproved_on` datetime DEFAULT NULL,
  `archived_by` int(11) DEFAULT NULL,
  `archived_on` datetime DEFAULT NULL,
  `archived_reason` text DEFAULT NULL,
  `disapproved_reason` text DEFAULT NULL,
  `returned_by` int(11) DEFAULT NULL,
  `returned_on` datetime DEFAULT NULL,
  `returned_reason` text DEFAULT NULL,
  `approved_reason` text DEFAULT NULL,
  `added_by` int(11) NOT NULL,
  `added_on` datetime NOT NULL,
  `updated_by` int(11) DEFAULT NULL,
  `updated_on` datetime DEFAULT NULL,
  `is_deleted` tinyint(4) NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

