--
-- Table structure for table `quotation_service_package_detail`
--

CREATE TABLE `quotation_service_package_detail` (
  `id` int(11) NOT NULL,
  `quotation_service_id` int(11) NOT NULL,
  `quotation_id` int(11) NOT NULL,
  `package_id` int(11) NOT NULL,
  `lab_test_id` int(11) NOT NULL,
  `price` decimal(13,4) NOT NULL DEFAULT 0.0000,
  `margin` decimal(13,2) NOT NULL DEFAULT 0.00,
  `cost` decimal(13,2) NOT NULL DEFAULT 0.00,
  `pro_rate_price` decimal(13,2) NOT NULL DEFAULT 0.00,
  `discount` decimal(13,2) NOT NULL DEFAULT 0.00,
  `total_amount` decimal(13,4) NOT NULL DEFAULT 0.0000,
  `branch_id` varchar(11) DEFAULT NULL,
  `charge_to` varchar(250) DEFAULT NULL,
  `head_count` int(11) DEFAULT NULL,
  `discount_amount` decimal(13,2) DEFAULT NULL,
  `margin_amount` decimal(13,2) DEFAULT NULL,
  `sales` decimal(13,2) DEFAULT 0.00,
  `admin_fee` decimal(13,2) DEFAULT 0.00,
  `direct_cost` decimal(13,2) DEFAULT 0.00,
  `manpower_cost` decimal(13,2) DEFAULT 0.00,
