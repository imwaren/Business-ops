--
-- Table structure for table `quotation_signed_moa`
--

CREATE TABLE `quotation_signed_moa` (
  `id` bigint(20) NOT NULL,
  `quotation_id` int(11) NOT NULL,
  `file_name` varchar(255) NOT NULL,
  `file_path` varchar(255) DEFAULT NULL,
  `file_url` longtext DEFAULT NULL,
  `mime` varchar(255) NOT NULL,
  `added_on` datetime NOT NULL DEFAULT current_timestamp(),
  `added_by` bigint(20) DEFAULT NULL,
  `updated_on` datetime DEFAULT NULL,
  `updated_by` bigint(20) DEFAULT NULL,
  `is_deleted` tinyint(1) NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------

--
-- Table structure for table `request`
--

CREATE TABLE `request` (
  `id` int(11) NOT NULL,
  `version_no` int(11) NOT NULL DEFAULT 1,
  `company_id` int(11) DEFAULT NULL,
  `customer_account_id` varchar(250) DEFAULT NULL,
  `reference_no` varchar(50) DEFAULT NULL,
  `name` varchar(250) DEFAULT NULL,
  `description` text DEFAULT NULL,
  `request_type` enum('new','repeat','custom') DEFAULT 'new',
  `priority` enum('low','medium','high','urgent') DEFAULT 'medium',
  `due_date` date DEFAULT NULL,
  `contact_person` varchar(150) DEFAULT NULL,
  `contact_number` varchar(50) DEFAULT NULL,
  `email` varchar(150) DEFAULT NULL,
  `delivery_address` text DEFAULT NULL,
  `payment_terms` text DEFAULT NULL,
  `grand_total` decimal(13,2) NOT NULL DEFAULT 0.00,
  `date` date DEFAULT NULL,
  `sae_in_charge_id` int(11) DEFAULT NULL,
  `rdt_requester` varchar(255) DEFAULT NULL COMMENT 'branch',
  `mode_of_payment` varchar(255) DEFAULT NULL,
  `preferred_branch_id` varchar(255) DEFAULT NULL,
  `hmo_account_name` varchar(255) DEFAULT NULL,
  `estimated_headcount` varchar(255) DEFAULT NULL,
  `number_of_days` varchar(255) DEFAULT NULL,
  `shift` varchar(255) DEFAULT NULL,
  `with_masterlist` int(11) NOT NULL DEFAULT 0,
  `with_walk_in` int(11) NOT NULL DEFAULT 0,
  `service_duration_date_from` date DEFAULT NULL,
  `service_duration_date_to` date DEFAULT NULL,
  `transaction_type` varchar(255) DEFAULT NULL,
  `male_35_plus` varchar(255) DEFAULT NULL,
  `female_35_plus` varchar(255) DEFAULT NULL,
  `classification` varchar(255) DEFAULT NULL,
  `signatory` varchar(255) DEFAULT NULL,
  `signatory_designation` varchar(255) DEFAULT NULL,
  `remarks` text DEFAULT NULL,
  `guaranteed_headcount` varchar(250) DEFAULT NULL,
  `mobile_site` varchar(255) DEFAULT NULL,
  `email_result` varchar(250) DEFAULT NULL,
  `evaluation_data_source` varchar(255) DEFAULT NULL,
  `estimated_patient_per_shift` varchar(250) DEFAULT NULL,
  `type_cost` decimal(13,2) NOT NULL DEFAULT 0.00,
  `mode_of_releasing` varchar(255) DEFAULT NULL,
  `status` enum('pending','approved','disapproved','archived','returned') DEFAULT 'pending',
  `disapproved_reason` text DEFAULT NULL,
  `returned_by` int(11) DEFAULT NULL,
  `returned_on` datetime DEFAULT NULL,
  `returned_reason` text DEFAULT NULL,
  `approved_reason` text DEFAULT NULL,
  `approved_by` int(11) DEFAULT NULL,
  `approved_on` datetime DEFAULT NULL,
  `disapproved_by` int(11) DEFAULT NULL,
  `disapproved_on` datetime DEFAULT NULL,
  `archived_by` int(11) DEFAULT NULL,
  `archived_on` datetime DEFAULT NULL,
  `archived_reason` text DEFAULT NULL,
  `added_by` int(11) NOT NULL,
  `added_on` datetime NOT NULL,
  `updated_by` int(11) DEFAULT NULL,
  `updated_on` datetime DEFAULT NULL,
  `is_deleted` tinyint(4) NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

