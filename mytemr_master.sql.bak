--
-- Table structure for table `costing_manpower_cost_premium_pay`
--

CREATE TABLE `costing_manpower_cost_premium_pay` (
  `id` int(11) NOT NULL,
  `costing_id` int(11) NOT NULL,
  `costing_manpower_cost_id` int(11) DEFAULT NULL,
  `premium_pay` varchar(255) DEFAULT NULL,
  `premium_pay_amount` decimal(13,2) NOT NULL DEFAULT 0.00,
  `premium_hrs` decimal(13,2) DEFAULT 0.00,
  `ingress_hrs` decimal(13,2) DEFAULT 0.00,
  `total_premium_pay` decimal(13,2) DEFAULT 0.00,
  `total` decimal(13,2) DEFAULT 0.00,
  `added_by` int(11) NOT NULL,
  `added_on` datetime NOT NULL,
  `updated_by` int(11) DEFAULT NULL,
  `updated_on` datetime DEFAULT NULL,
  `is_deleted` tinyint(4) NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

