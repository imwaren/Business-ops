--
-- Table structure for table `costing_manpower`
--

CREATE TABLE `costing_manpower` (
  `id` int(11) NOT NULL,
  `costing_id` int(11) NOT NULL,
  `description` text DEFAULT NULL,
  `manpower_type` varchar(250) DEFAULT NULL,
  `qty` decimal(13,4) DEFAULT 0.0000,
  `daily_rate` decimal(13,4) DEFAULT 0.0000,
  `total_daily_rate` decimal(13,4) DEFAULT 0.0000,
  `meals` decimal(13,4) DEFAULT 0.0000,
  `ingress_count` decimal(13,4) DEFAULT 0.0000,
  `rate` decimal(13,4) DEFAULT 0.0000,
  `pax_per_hour` decimal(10,0) NOT NULL DEFAULT 0,
  `minutes_per_pax` decimal(10,0) NOT NULL DEFAULT 0,
  `active_hours` decimal(10,0) NOT NULL DEFAULT 0,
  `suggested_qty` decimal(10,0) NOT NULL DEFAULT 0,
  `patient_per_shift` decimal(13,2) NOT NULL DEFAULT 0.00,
  `added_by` int(11) NOT NULL,
  `added_on` datetime NOT NULL,
  `updated_by` int(11) DEFAULT NULL,
  `updated_on` datetime DEFAULT NULL,
  `is_deleted` tinyint(4) NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

