--
-- Table structure for table `request_shift`
--

CREATE TABLE `request_shift` (
  `id` int(11) NOT NULL,
  `request_id` int(11) NOT NULL,
  `name` varchar(250) DEFAULT NULL,
  `start_shift` time NOT NULL,
  `end_shift` time NOT NULL,
  `registration_cut_off` time NOT NULL,
  `specimen_submission_cut_off` time NOT NULL,
  `total_hours` decimal(13,2) NOT NULL DEFAULT 0.00,
  `break` varchar(250) DEFAULT NULL,
  `ingress` time DEFAULT NULL,
  `added_by` int(11) NOT NULL,
  `added_on` datetime NOT NULL,
  `updated_by` int(11) DEFAULT NULL,
  `updated_on` datetime DEFAULT NULL,
  `is_deleted` tinyint(4) NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

