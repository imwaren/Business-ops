use CodeIgniter\Boot;
use Config\Paths;

if (strpos(PHP_SAPI, 'cgi') === 0) {
    exit("The cli tool is not supported when running php-cgi. It needs php-cli to function!\n\n");
}

error_reporting(-1);
ini_set('display_errors', '1');

define('FCPATH', __DIR__ . DIRECTORY_SEPARATOR);
chdir(FCPATH);

require FCPATH . 'app/Config/BootstrapGuard.php';

$minPhpVersion = '8.1';
bootstrap_ensure_php($minPhpVersion, static function (string $code, string $message): void {
    bootstrap_fail_cli($code, $message, FCPATH);
});

require FCPATH . 'app/Config/Paths.php';

$paths    = new Paths();
$rootPath = bootstrap_safe_root($paths->appDirectory);

bootstrap_ensure_vendor($rootPath, static function (string $code, string $message) use ($rootPath): void {
    bootstrap_fail_cli($code, $message, $rootPath);
});
bootstrap_ensure_writable($rootPath, static function (string $code, string $message) use ($rootPath): void {
    bootstrap_fail_cli($code, $message, $rootPath);
});

$systemDirectory = rtrim($paths->systemDirectory, '\\/ ');
$dotEnv          = $systemDirectory . DIRECTORY_SEPARATOR . 'Config' . DIRECTORY_SEPARATOR . 'DotEnv.php';
if (! is_file($dotEnv)) {
    bootstrap_fail_cli('vendor_missing', 'Bootstrap failed: run composer install --no-dev in the document root.', $rootPath);
}

require_once $dotEnv;
(new CodeIgniter\Config\DotEnv($rootPath))->load();

require $paths->systemDirectory . '/Boot.php';

try {
    exit(Boot::bootSpark($paths));
} catch (Throwable $e) {
    bootstrap_write_error($rootPath, 'boot_exception: ' . $e->getMessage());
    bootstrap_fail_cli(
        'boot_exception',
        'Application bootstrap failed. See writable/logs/boot-error.log.',
        $rootPath
    );
}
